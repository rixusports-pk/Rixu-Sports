        category: "Gloves",
        image: "gloves.jpg",
        emoji: "🧤"
      },

      {
        name: "Cricket Batting Pads",
        price: "Rs. 4,500",
        category: "Pads",
        image: "pods.jpg",
        emoji: "🦵"
      },

      {
        name: "Professional Cricket Helmet",
        price: "Rs. 5,500",
        category: "Helmet",
