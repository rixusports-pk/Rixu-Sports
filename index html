        name: "Premium Cricket Shirt",
        price: "Rs. 2,200",
        category: "Clothing",
        image: "tshirt.webp",
        emoji: "👕"
      },

      {
        name: "Cricket Trousers",
        price: "Rs. 2,000",
        category: "Clothing",
        image: "trouser.jpg",
        emoji: "👖"
      },

      {
        name: "Professional Cricket Ball",
        price: "Rs. 1,200",
        category: "Balls",
        image: "ball.jpg",
        emoji: "🏏"
      },

      {
        name: "Cricket Sports Bag",
        price: "Rs. 3,000",
        category: "Accessories",
        image: "bag.jpg",
        emoji: "🎒"
      }

    ];


    /* ==========================================
       DISPLAY PRODUCTS
    ========================================== */

    function displayProducts(category = "All") {

      const grid = document.getElementById("productGrid");

      grid.innerHTML = "";

      const filtered = category === "All"
        ? products
        : products.filter(product => product.category === category);


      filtered.forEach(product => {

        const card = document.createElement("div");

        card.className = "product-card";

        let imageHTML = "";

        if (product.image) {

          imageHTML = `
            <img
              src="${product.image}"
              alt="${product.name}"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            >
            <div class="placeholder" style="display:none;">
              ${product.emoji}
            </div>
          `;

        } else {

          imageHTML = `
            <div class="placeholder">
              ${product.emoji}
            </div>
          `;

        }


        card.innerHTML = `

          <div class="product-image">
            ${imageHTML}
          </div>

          <div class="product-info">

            <div class="product-category">
              ${product.category}
            </div>

            <div class="product-name">
              ${product.name}
            </div>

            <div class="product-price">
              ${product.price}
            </div>

            <button
              class="order-btn"
              onclick="orderProduct('${escapeQuotes(product.name)}','${escapeQuotes(product.price)}')"
            >
              Order Now
            </button>

          </div>

        `;

        grid.appendChild(card);

      });

    }


    /* ==========================================
       WHATSAPP PRODUCT ORDER
    ========================================== */

    function orderProduct(name, price) {

      const message =
`Assalamualaikum AI Sports, I want to order:

Product: ${name}
Price: ${price}

Please confirm availability.`;

      const url =
        "https://wa.me/" +
        WHATSAPP_NUMBER +
        "?text=" +
        encodeURIComponent(message);

      window.open(url, "_blank");

    }


    /* ==========================================
       GENERAL WHATSAPP
    ========================================== */

    function generalWhatsApp() {

      const message =
        "Assalamualaikum AI Sports, I want to know more about your cricket products.";

      const url =
        "https://wa.me/" +
        WHATSAPP_NUMBER +
        "?text=" +
        encodeURIComponent(message);

      window.open(url, "_blank");

    }


    /* ==========================================
       FILTER PRODUCTS
    ========================================== */

    function filterProducts(category, button) {

      displayProducts(category);

      if (button) {

        document.querySelectorAll(".filter-btn")
          .forEach(btn => btn.classList.remove("active"));

        button.classList.add("active");

      }

      document.getElementById("shop")
        .scrollIntoView({
          behavior: "smooth"
        });

    }


    /* ==========================================
       MOBILE MENU
    ========================================== */

    function toggleMenu() {

      document
        .getElementById("navLinks")
        .classList.toggle("show");

    }


    /* ==========================================
       ESCAPE QUOTES
    ========================================== */

    function escapeQuotes(text) {

      return text
        .replace(/'/g, "\\'")
        .replace(/"/g, '&quot;');

    }


    /* ==========================================
       INITIAL LOAD
    ========================================== */

    displayProducts();


    /* Close mobile menu after clicking link */

    document.querySelectorAll(".nav-links a")
      .forEach(link => {

        link.addEventListener("click", () => {

          document
            .getElementById("navLinks")
            .classList.remove("show");

        });

      });

  </script>

