<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AI Sports | Cricket Gear</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    :root {
      --black: #050505;
      --dark: #0b0b0b;
      --card: #111111;
      --yellow: #ffd900;
      --orange: #ff5a00;
      --white: #ffffff;
      --gray: #a6a6a6;
      --border: rgba(255, 217, 0, 0.22);
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--black);
      color: var(--white);
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    /* =========================
       TOP BAR
    ========================== */

    .top-bar {
      background: var(--yellow);
      color: #000;
      text-align: center;
      padding: 8px 15px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* =========================
       NAVBAR
    ========================== */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(5, 5, 5, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .navbar {
      max-width: 1250px;
      margin: auto;
      height: 75px;
      padding: 0 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 24px;
      font-weight: 1000;
      letter-spacing: -1px;
      line-height: 20px;
    }

    .logo span {
      color: var(--orange);
    }

    .logo small {
      display: block;
      font-size: 7px;
      letter-spacing: 3px;
      color: #aaa;
      margin-top: 6px;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
      list-style: none;
    }

    .nav-links a {
      font-size: 13px;
      font-weight: 700;
      color: #ddd;
      transition: .3s;
    }

    .nav-links a:hover {
      color: var(--yellow);
    }

    .nav-whatsapp {
      background: var(--yellow);
      color: #000 !important;
      padding: 11px 18px;
      border-radius: 5px;
    }

    .menu-btn {
      display: none;
      border: 0;
      background: none;
      color: white;
      font-size: 28px;
      cursor: pointer;
    }

/* =========================
       HERO
    ========================== */

.hero {
  min-height: 85vh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: 
    linear-gradient(90deg, rgba(0,0,0,0.85) 30%, rgba(0,0,0,0.1) 100%),
    url('hero.jpeg') no-repeat center center / cover;
}



    .hero::before {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      right: -100px;
      top: 50px;
      border-radius: 50%;
      background: rgba(255, 90, 0, .08);
      filter: blur(50px);
    }

    .hero-content {
      width: 1250px;
      max-width: 100%;
      margin: auto;
      padding: 70px 25px;
      position: relative;
      z-index: 2;
    }

    .hero-label {
      color: var(--orange);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 3px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(65px, 10vw, 135px);
      line-height: .78;
      font-weight: 1000;
      letter-spacing: -6px;
      text-transform: uppercase;
      max-width: 650px;
    }

    .hero h1 span {
      color: var(--yellow);
    }

    .hero-text {
      color: #aaa;
      max-width: 480px;
      margin-top: 35px;
      line-height: 1.7;
      font-size: 15px;
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
      margin-top: 30px;
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      padding: 15px 25px;
      font-weight: 900;
      cursor: pointer;
      border-radius: 4px;
      transition: .3s;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: .7px;
    }

    .btn-yellow {
      background: var(--yellow);
      color: #000;
    }

    .btn-yellow:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(255,217,0,.2);
    }

    .btn-outline {
      background: transparent;
      color: white;
      border: 1px solid #555;
    }

    .btn-outline:hover {
      border-color: var(--yellow);
      color: var(--yellow);
    }

    .hero-product {
      position: absolute;
      right: 7%;
      top: 50%;
      transform: translateY(-50%);
      width: 420px;
      height: auto;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-real-image {
      width: 100%;
      max-width: 400px;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.7));
      animation: batFloat 4s ease-in-out infinite;
    }

    .hero-number {
      position: absolute;
      right: 0;
      top: 70px;
      border-left: 2px solid var(--orange);
      padding-left: 15px;
      font-size: 10px;
      color: var(--orange);
      letter-spacing: 2px;
    }

    /* =========================
       SECTION
    ========================== */

    section {
      padding: 90px 25px;
    }

    .container {
      max-width: 1250px;
      margin: auto;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 40px;
    }

    .section-label {
      color: var(--orange);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }

    .section-title {
      font-size: clamp(35px, 5vw, 60px);
      font-weight: 1000;
      text-transform: uppercase;
      letter-spacing: -2px;
    }

    .section-desc {
      color: var(--gray);
      max-width: 420px;
      line-height: 1.6;
      font-size: 14px;
    }

    /* =========================
       CATEGORIES
    ========================== */

    .categories {
      background: #090909;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }

    .category {
      min-height: 150px;
      border: 1px solid #222;
      background: linear-gradient(145deg, #141414, #080808);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: end;
      transition: .3s;
      cursor: pointer;
    }

    .category:hover {
      border-color: var(--yellow);
      transform: translateY(-5px);
    }

    .category-icon {
      font-size: 35px;
      margin-bottom: auto;
    }

    .category h3 {
      font-size: 15px;
      text-transform: uppercase;
    }

    /* =========================
       PRODUCTS
    ========================== */

    .products {
      background: #050505;
    }

    .filters {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 30px;
    }

    .filter-btn {
      background: #111;
      border: 1px solid #292929;
      color: #bbb;
      padding: 10px 16px;
      cursor: pointer;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 800;
    }

    .filter-btn.active,
    .filter-btn:hover {
      background: var(--yellow);
      color: #000;
      border-color: var(--yellow);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .product-card {
      background: var(--card);
      border: 1px solid #202020;
      overflow: hidden;
      transition: .3s;
    }

    .product-card:hover {
      transform: translateY(-6px);
      border-color: rgba(255,217,0,.5);
    }

    .product-image {
      height: 250px;
      position: relative;
      background:
        radial-gradient(circle at center, rgba(255,217,0,.08), transparent 55%),
        #0d0d0d;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .placeholder {
      font-size: 75px;
      opacity: .8;
    }

    .product-info {
      padding: 18px;
    }

    .product-category {
      font-size: 9px;
      color: var(--orange);
      font-weight: 900;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .product-name {
      font-size: 17px;
      font-weight: 900;
      margin: 8px 0;
    }

    .product-price {
      color: var(--yellow);
      font-weight: 900;
      font-size: 18px;
      margin-bottom: 15px;
    }

    .order-btn {
      width: 100%;
      background: var(--yellow);
      color: #000;
      border: 0;
      padding: 12px;
      font-weight: 900;
      cursor: pointer;
      text-transform: uppercase;
      transition: .3s;
    }

    .order-btn:hover {
      background: #fff;
    }

    /* =========================
       OFFER
    ========================== */

    .offer {
      background:
        linear-gradient(90deg, rgba(0,0,0,.95), rgba(0,0,0,.45)),
        radial-gradient(circle at 80% 50%, rgba(255,90,0,.3), transparent 35%),
        #15100c;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .offer-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .offer h2 {
      font-size: clamp(40px, 6vw, 75px);
      font-weight: 1000;
      text-transform: uppercase;
    }

    .offer h2 span {
      color: var(--yellow);
    }

    .offer p {
      color: #bbb;
      margin-top: 15px;
      line-height: 1.6;
    }

    /* =========================
       WHY US
    ========================== */

    .why-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .why-card {
      background: #0d0d0d;
      border: 1px solid #202020;
      padding: 30px 22px;
      min-height: 200px;
    }

    .why-icon {
      font-size: 28px;
      margin-bottom: 35px;
    }

    .why-card h3 {
      font-size: 15px;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .why-card p {
      color: #888;
      font-size: 13px;
      line-height: 1.6;
    }

    /* =========================
       ABOUT
    ========================== */

    .about {
      background: #090909;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-image {
      min-height: 420px;
      background:
        linear-gradient(135deg, rgba(255,90,0,.15), transparent),
        #111;
      border: 1px solid #292929;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 100px;
    }

    .about-text p {
      color: #999;
      line-height: 1.9;
      margin: 25px 0;
    }

    /* =========================
       CONTACT
    ========================== */

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .contact-card {
      background: #0d0d0d;
      border: 1px solid #222;
      padding: 35px;
    }

    .contact-card h3 {
      font-size: 25px;
      margin-bottom: 25px;
    }

    .contact-item {
      padding: 15px 0;
      border-bottom: 1px solid #222;
      color: #aaa;
    }

    .contact-item strong {
      color: white;
      display: block;
      margin-bottom: 5px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      background: #020202;
      border-top: 1px solid #1c1c1c;
      padding: 55px 25px 25px;
    }

    .footer-grid {
      max-width: 1250px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }

    .footer-text {
      color: #777;
      line-height: 1.7;
      max-width: 350px;
      margin-top: 15px;
      font-size: 13px;
    }

    .footer-title {
      font-size: 12px;
      color: var(--yellow);
      letter-spacing: 2px;
      margin-bottom: 18px;
      font-weight: 900;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin: 10px 0;
      color: #888;
      font-size: 13px;
    }

    .footer-links li:hover {
      color: white;
    }

    .copyright {
      max-width: 1250px;
      margin: 45px auto 0;
      padding-top: 20px;
      border-top: 1px solid #1b1b1b;
      color: #555;
      font-size: 11px;
      text-align: center;
    }

    /* =========================
       FLOATING WHATSAPP
    ========================== */

    .whatsapp-float {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 2000;
      background: #25D366;
      color: white;
      border-radius: 50px;
      padding: 13px 18px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 900;
      font-size: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,.5);
      transition: .3s;
    }

    .whatsapp-float:hover {
      transform: scale(1.05);
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 1000px) {

      .product-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .category-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .why-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero-product {
        opacity: .35;
        right: -100px;
      }
    }

    @media (max-width: 700px) {

      .navbar {
        height: 65px;
        padding: 0 17px;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        position: absolute;
        left: 0;
        top: 65px;
        width: 100%;
        background: #080808;
        border-bottom: 1px solid #222;
        flex-direction: column;
        padding: 20px;
        gap: 20px;
        display: none;
      }

      .nav-links.show {
        display: flex;
      }

      .hero {
        min-height: 650px;
      }

      .hero-content {
        padding: 70px 20px;
      }

      .hero h1 {
        font-size: 68px;
        letter-spacing: -4px;
      }

      .hero-product {
        opacity: .18;
        right: -160px;
      }

      section {
        padding: 65px 18px;
      }

      .section-head {
        display: block;
      }

      .section-desc {
        margin-top: 15px;
      }

      .category-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .product-image {
        height: 180px;
      }

      .product-info {
        padding: 13px;
      }

      .product-name {
        font-size: 14px;
      }

      .product-price {
        font-size: 15px;
      }

      .offer-box {
        display: block;
      }

      .offer .btn {
        margin-top: 25px;
      }

      .why-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .why-card {
        padding: 20px 15px;
        min-height: 180px;
      }

      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .about-image {
        min-height: 280px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .whatsapp-float {
        right: 14px;
        bottom: 14px;
        padding: 12px 15px;
      }
    }

    @media (max-width: 400px) {
      .hero h1 {
        font-size: 55px;
      }

      .product-grid {
        grid-template-columns: 1fr 1fr;
      }

      .category-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* =========================
   AI SPORTS ANIMATIONS
========================= */

/* Hero entrance */
.hero-label {
  animation: fadeUp 1s ease forwards;
}

.hero h1 {
  animation: heroTitle 1s ease forwards;
}

.hero-text {
  animation: fadeUp 1s ease 0.2s forwards;
  opacity: 0;
}

.hero-buttons {
  animation: fadeUp 1s ease 0.4s forwards;
  opacity: 0;
}

/* Bat floating */
.hero-product .hero-real-image {
  animation: batFloat 4s ease-in-out infinite;
}

/* Hero glow */
.hero::before {
  animation: glowPulse 4s ease-in-out infinite;
}

/* Product cards */
.product-card {
  animation: cardAppear 0.7s ease both;
}

.product-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 0 15px 40px rgba(255, 90, 0, 0.15);
}

/* Category cards */
.category {
  transition: all 0.4s ease;
}

.category:hover {
  transform: translateY(-10px) scale(1.03);
  box-shadow: 0 15px 35px rgba(255, 217, 0, 0.12);
}

/* Buttons */
.btn,
.order-btn {
  transition: all 0.3s ease;
}

.btn-yellow:hover,
.order-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(255, 217, 0, 0.3);
}

/* WhatsApp pulse */
.whatsapp-float {
  animation: whatsappPulse 2s infinite;
}


/* =========================
   KEYFRAMES
========================= */

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heroTitle {
  from {
    opacity: 0;
    transform: translateX(-50px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes batFloat {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-18px);
  }
}

@keyframes glowPulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

@keyframes cardAppear {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes whatsappPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4);
  }

  70% {
    box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
  }
}

/* WHY AI SPORTS - IMAGE ICONS */

.why-image {
  width: 150px;
  height: 150px;
  object-fit: cover;
  border-radius: 14px;
  display: block;
  margin: 0 auto 18px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.why-card:hover .why-image {
  transform: scale(1.08);
}
 
.about-logo {
  width: 750px;
  max-width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}
 </style>
</head>

<body>

