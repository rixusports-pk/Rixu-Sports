    ========================================== */

    const WHATSAPP_NUMBER = "923418011877";


    /* ==========================================
       PRODUCTS
       
       Baad mein yahan apne products add/edit
       kar sakte ho.
       
       image: apni image ka path
       Example:
       images/bat.jpg
    ========================================== */

    const products = [

      {
        name: "Premium Cricket Bat",
        price: "Rs. 8,500",
        category: "Bats",
        image: "bts.jpeg",
        emoji: "🏏"
      },

       {
